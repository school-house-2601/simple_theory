{
  "name": "simple-theory-server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#db/*": "./db/*.js",
    "#middleware/*": "./middleware/*.js",
    "#utils/*": "./utils/*.js",
    "#api/*": "./api/*.js",
    "#app": "./app.js"
  },
  "scripts": {
    "start": "node --env-file=.env index.js",
    "dev": "tsx watch --env-file=./.env index.js",
    "db:schema": "psql -d simple_theory -f db/schema.sql",
    "db:seed": "node --env-file=.env db/seed.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test": "vitest run",
    "lint": "eslint . --ext .js --ignore-path .gitignore",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.14.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "vitest": "^4.1.8"
  }
}
