{
  "version": 2,
  "builds": [
    {
      "src": "server/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "client/dist" }
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/users/(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/lessons/(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/progress/(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/stats/(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/xp/(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/bookmarks/(.*)",
      "dest": "server/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/index.html"
    }
  ]
}
